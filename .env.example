# ------------------------------------------------------------------
# Biomass Engineers Ltd — environment variables
# Copy this file to .env.local (development) or set in hosting provider
# (Vercel / Netlify / Coolify / Railway). NEVER commit secrets to git.
# ------------------------------------------------------------------

# --- Contact form ---------------------------------------------------
# n8n webhook receiving submitted enquiries (production URL — always armed).
# Override if pointing at a different automation backend.
CONTACT_WEBHOOK_URL="https://auto.juxtarank.com/webhook/biomass-contact"

# Resend transactional email (used as a secondary delivery path).
# Get a key at https://resend.com → API Keys. Leave blank to disable
# the email path (webhook delivery is sufficient on its own).
RESEND_API_KEY=""

# Inbox that contact-form Resend emails are sent to.
# Defaults to info@biomass-engineers.co.uk if unset.
CONTACT_EMAIL="admin@biomass-engineers.co.uk"

# --- Chat widget ----------------------------------------------------
# n8n webhook backing the "Ask Biomass Engineers" chat widget.
# Returns JSON (object or array) — proxy extracts output/response/message/text/reply.
CHAT_WEBHOOK_URL="https://auto.juxtarank.com/webhook/biomass-chat"

# ------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------
# - Both webhook URLs already have sensible defaults hardcoded in the API
#   routes, so the site will work without overrides. Set these env vars
#   only if you want to point at a different automation environment
#   (e.g. staging vs production n8n workflows).
# - At go-live, also flip:
#     app/robots.ts  → restore the per-bot allow rules
#     app/layout.tsx → robots: { index: true, follow: true }
# - Sub-domain pre-launch: both currently block all crawlers.
